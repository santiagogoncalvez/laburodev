# Imagen del backend para Vercel Container Runtime (Docker punto 2 — Fase 0).
# Multi-stage (TypeScript):
#   build:  npm ci (incluye dev: typescript) + npm run build → dist/
#   runner: fuente completa (para db:seed en el contenedor) + dist/ compilado.
# ENV NODE_ENV=production: app.ts NO hace listen() (guard serverless), asi que
# el unico que escucha es dist/server.js (compilado de server.ts).
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-alpine AS runner
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# dist despues de COPY . . para que siempre gane el build fresco (no el dist local)
COPY --from=build /app/dist ./dist
# node solo necesita escribir en /app (crea local.db si no hay TURSO_DATABASE_URL)
RUN chown node:node /app

# Vercel envia trafico al puerto 80 por defecto; PORT se puede setear en project
# settings. Localmente sin PORT: 3000 (mismo criterio que app.ts / config.ts).
ENV NODE_ENV=production
EXPOSE 3000
USER node
CMD ["node", "dist/server.js"]
